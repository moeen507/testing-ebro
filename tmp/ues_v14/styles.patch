+/* Profile settings */
+.profile-layout{display:grid;grid-template-columns:minmax(340px,.72fr) minmax(480px,1.28fr);gap:14px}.profile-identity-card{display:flex;align-items:center;gap:22px;padding:26px!important}.profile-photo-wrap{text-align:center}.profile-photo{overflow:hidden;box-shadow:0 22px 55px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.12)}.photo-status{display:block;font-size:9px;color:#7f7178;margin-top:10px}.profile-identity-copy h2{font-size:27px;margin:6px 0 4px;letter-spacing:-.6px}.profile-identity-copy p{font-size:12px;color:#93858c;margin:0}.profile-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}.appearance-panel{padding:22px!important}.theme-choice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.theme-choice{position:relative;text-align:left;min-height:156px;padding:12px;border-radius:17px;border:1px solid rgba(255,255,255,.075);background:rgba(255,255,255,.025);color:#fff;transition:.22s ease}.theme-choice:hover{transform:translateY(-2px);border-color:rgba(226,188,115,.20);background:rgba(255,255,255,.04)}.theme-choice.active{border-color:rgba(229,190,116,.34);box-shadow:0 12px 30px rgba(0,0,0,.18),inset 0 0 0 1px rgba(229,190,116,.06)}.theme-choice b{display:block;font-size:11px;margin-top:11px}.theme-choice small{display:block;font-size:9px;line-height:1.4;color:#84767d;margin-top:4px}.theme-choice em{position:absolute;right:9px;top:9px;font-style:normal;font-size:8px;color:#efcf8e;background:rgba(216,176,99,.10);border:1px solid rgba(220,180,104,.16);padding:4px 6px;border-radius:8px}.theme-preview{height:72px;border-radius:12px;display:flex;gap:5px;align-items:flex-end;padding:8px;border:1px solid rgba(255,255,255,.07);overflow:hidden}.theme-preview.signature{background:radial-gradient(circle at 85% 0,#5c1730,transparent 48%),#0e0a0d}.theme-preview.obsidian{background:radial-gradient(circle at 85% 0,#29292d,transparent 50%),#050607}.theme-preview.deep_maroon{background:radial-gradient(circle at 80% 0,#8b1739,transparent 52%),#0c0508}.theme-preview i{display:block;width:24%;border-radius:5px;background:rgba(255,255,255,.10)}.theme-preview i:nth-child(1){height:68%}.theme-preview i:nth-child(2){height:45%;width:35%}.theme-preview i:nth-child(3){height:82%;width:28%}.motion-setting{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,.065)}.motion-setting b{display:block;font-size:12px}.motion-setting small{display:block;font-size:9px;color:#81747b;margin-top:4px}.segmented{display:flex;padding:4px;border-radius:13px;background:rgba(5,5,7,.55);border:1px solid rgba(255,255,255,.065)}.segmented button{border:0;background:transparent;color:#897b82;border-radius:9px;min-height:36px;padding:0 12px;font-size:9px;font-weight:750}.segmented button.active{color:#fff;background:#512034;box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}.profile-details-panel{margin-top:14px!important}
