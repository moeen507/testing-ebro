+.profile-menu-head{display:flex;align-items:center;gap:11px;padding:9px 9px 12px;border-bottom:1px solid rgba(255,255,255,.065);margin-bottom:5px}.profile-menu-head b{display:block;font-size:12px}.profile-menu-head small{display:block;font-size:9px;color:#887a81;margin-top:2px}.profile-menu>button{width:100%;display:grid;grid-template-columns:35px 1fr;gap:9px;align-items:center;text-align:left;border:0;background:transparent;color:#e9e0e4;border-radius:14px;padding:10px;transition:.18s ease}.profile-menu>button:hover{background:rgba(255,255,255,.055)}.profile-menu>button>span{font-size:18px;display:grid;place-items:center}.profile-menu>button b{display:block;font-size:11px}.profile-menu>button small{display:block;font-size:9px;color:#84767d;margin-top:2px}.profile-menu-sep{height:1px;background:rgba(255,255,255,.065);margin:5px 7px}.profile-menu .danger-menu{color:#ffb1b7}.profile-menu .danger-menu:hover{background:rgba(214,60,76,.08)}
