+.auth-form{padding:26px 4px 6px}.form-title h2{font-size:30px;letter-spacing:-.7px}.form-title p{font-size:13px;line-height:1.6;margin-bottom:24px}.auth-form label{gap:9px;font-size:12px;margin-bottom:17px}.auth-form input{min-height:55px;border-radius:15px;padding:0 15px;font-size:15px;background:rgba(7,6,8,.55);border:1px solid rgba(255,255,255,.085);box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}.auth-form input:focus{border-color:rgba(205,81,120,.66);box-shadow:0 0 0 4px rgba(169,40,79,.13),inset 0 1px 0 rgba(255,255,255,.04);background:rgba(10,7,10,.75)}
