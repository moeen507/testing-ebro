+/* Persistent account control: profile + logout is always reachable. */
+.profile-control{position:relative}.profile-trigger{height:48px;max-width:250px;display:flex;align-items:center;gap:10px;padding:4px 10px 4px 5px;border-radius:16px;border:1px solid rgba(255,255,255,.075);background:linear-gradient(145deg,rgba(255,255,255,.052),rgba(255,255,255,.018));color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.045);transition:.22s ease}.profile-trigger:hover{border-color:rgba(227,190,119,.20);background:rgba(255,255,255,.055)}.profile-trigger .avatar{width:39px;height:39px;border-radius:13px}.profile-trigger-copy{text-align:left;min-width:0}.profile-trigger-copy b{display:block;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}.profile-trigger-copy small{display:block;color:#897b82;font-size:9px;margin-top:2px}.profile-trigger>svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;margin-left:auto;color:#82757c}.avatar.has-photo{overflow:hidden;padding:0;background:#171216}.avatar.has-photo img,.profile-photo.has-photo img{width:100%;height:100%;object-fit:cover;display:block}
