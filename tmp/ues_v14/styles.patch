+.auth-brand{min-height:58px}.auth-grid{width:min(1240px,100%);grid-template-columns:minmax(0,1.16fr) minmax(390px,.72fr);gap:clamp(54px,8vw,116px);padding:clamp(30px,7vh,72px) 0}.auth-copy h1{font-size:clamp(48px,5.7vw,78px);max-width:780px}.auth-copy>p{font-size:15px;max-width:690px}.auth-card{position:relative;width:100%;max-width:510px;justify-self:end;padding:24px;border-radius:30px;background:radial-gradient(100% 80% at 20% 0%,rgba(255,255,255,.075),transparent 46%),linear-gradient(145deg,rgba(43,27,36,.84),rgba(14,11,14,.78));border:1px solid rgba(242,218,174,.15);box-shadow:0 38px 100px rgba(0,0,0,.52),0 8px 34px rgba(80,10,35,.12),inset 0 1px 0 rgba(255,255,255,.10);backdrop-filter:blur(36px) saturate(150%);-webkit-backdrop-filter:blur(36px) saturate(150%);overflow:visible;transition:transform .42s cubic-bezier(.2,.75,.2,1),box-shadow .42s ease}
