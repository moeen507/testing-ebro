+.auth-status-pop{position:absolute;left:50%;top:50%;z-index:20;width:min(330px,calc(100% - 36px));padding:19px 20px;display:flex;align-items:center;gap:14px;border-radius:22px;background:linear-gradient(145deg,rgba(28,21,25,.94),rgba(8,8,10,.94));border:1px solid rgba(255,255,255,.10);box-shadow:0 28px 90px rgba(0,0,0,.66),inset 0 1px 0 rgba(255,255,255,.08);backdrop-filter:blur(28px);opacity:0;visibility:hidden;transform:translate(-50%,-42%) scale(.90);pointer-events:none}.auth-status-pop.show{visibility:visible;animation:authStatusPop 1.7s cubic-bezier(.2,.8,.2,1) both}.auth-status-ring{width:58px;height:58px;border-radius:19px;display:grid;place-items:center;font-size:27px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);flex:none}.auth-status-pop.good .auth-status-ring{background:rgba(74,183,121,.12);border-color:rgba(100,219,151,.26);box-shadow:0 0 34px rgba(62,189,118,.12)}.auth-status-pop.bad .auth-status-ring{background:rgba(215,63,84,.12);border-color:rgba(241,100,116,.25);box-shadow:0 0 34px rgba(220,58,81,.12)}.auth-status-pop b{display:block;font-size:15px}.auth-status-pop small{display:block;font-size:11px;color:#a7969e;margin-top:4px;line-height:1.4}@keyframes authStatusPop{0%{opacity:0;transform:translate(-50%,-38%) scale(.82);filter:blur(7px)}15%,76%{opacity:1;transform:translate(-50%,-50%) scale(1);filter:none}100%{opacity:0;transform:translate(-50%,-57%) scale(.97);filter:blur(3px)}}
